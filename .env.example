# .env.example
HOUSECALL_API_KEY=
HOUSECALL_WEBHOOK_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Slack notifications (see docs/SLACK-ROLLOUT.md before setting SLACK_ALERTS_ENABLED=true)
SLACK_WEBHOOK_SCHEDULE=
SLACK_WEBHOOK_INVOICES=
SLACK_WEBHOOK_ESTIMATES=
SLACK_ALERTS_ENABLED=

# Password for the /admin page's "Send to Slack" buttons. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Unlike the secrets above you have to be able to read this one back to type it
# in, so keep a copy. It is the ONLY thing stopping a stranger who finds the URL
# from posting to the company Slack.
ADMIN_TRIGGER_TOKEN=

# --- Slack /trinity slash commands -------------------------------------------
# Slack app -> Basic Information -> App Credentials -> Signing Secret.
# This is the ONLY authentication on /api/slack/command.
SLACK_SIGNING_SECRET=

# Kill switch. Commands are inert unless this is the exact string "true"
# ("1", "yes" and "TRUE" all count as off), matching SLACK_ALERTS_ENABLED.
SLACK_COMMANDS_ENABLED=

# --- Turned-down calls (/trinity declined) -------------------------------------
# Off unless exactly "true". Covers /trinity declined, the #declined-calls count
# and the Monday report there (which also needs SLACK_ALERTS_ENABLED=true).
# Apply supabase/migrations/0007_declined_calls.sql before turning this on.
SLACK_DECLINED_ENABLED=

# Salt for hashing callers' phone numbers so a repeat caller counts once a week.
# The raw number is never stored. Generate once and never change it (changing it
# only means a repeat caller that week could count twice):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Unset: a /trinity declined entry with a phone number is refused.
DECLINED_PHONE_SALT=

# Bot token (xoxb-...) for counting forwards in #declined-calls and posting the
# Monday summary there. Slack app -> OAuth & Permissions -> Bot User OAuth Token.
# Scopes: channels:history (groups:history if the channel is private), chat:write.
# The bot must be invited to the channel. Unset: the Monday report is skipped and
# /trinity declined counts its own entries only.
SLACK_BOT_TOKEN=
# The channel ID of #declined-calls (C...), from channel details -> bottom.
SLACK_DECLINED_CHANNEL_ID=
